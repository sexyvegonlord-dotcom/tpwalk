local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local RunService = game:GetService("RunService")

local player = Players.LocalPlayer

local tpWalkAmount = 0
local enabled = false

UserInputService.InputBegan:Connect(function(input, processed)
    if processed then return end

    if input.KeyCode == Enum.KeyCode.T then
        enabled = false
        tpWalkAmount = 0
        print("TPWalk OFF")
    elseif input.KeyCode == Enum.KeyCode.Five then
        tpWalkAmount += 0.15
        enabled = true
        print("TPWalk amount:", tpWalkAmount)
    end
end)

RunService.Heartbeat:Connect(function()
    if not enabled or tpWalkAmount <= 0 then return end

    local character = player.Character
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")
    local root = character and character:FindFirstChild("HumanoidRootPart")

    if not humanoid or not root then return end

    local direction = humanoid.MoveDirection

    if direction.Magnitude > 0 then
        root.CFrame += direction.Unit * tpWalkAmount
    end
end)

local RunService = game:GetService("RunService")

local markers = {}

local function addPrompt(prompt)
    if markers[prompt] or not prompt:IsA("ProximityPrompt") then
        return
    end

    local parent = prompt.Parent
    if not parent then return end

    local adornee

    if parent:IsA("BasePart") then
        adornee = parent
    elseif parent:IsA("Attachment") then
        adornee = parent
    elseif parent:IsA("Model") then
        local part = parent:FindFirstChildWhichIsA("BasePart", true)
        adornee = part
    end

    if not adornee then return end

    local gui = Instance.new("BillboardGui")
    gui.Name = "PromptMarker"
    gui.Adornee = adornee
    gui.Size = UDim2.fromOffset(220, 50)
    gui.StudsOffset = Vector3.new(0, 3, 0)
    gui.AlwaysOnTop = true
    gui.Parent = game:GetService("CoreGui")

    local label = Instance.new("TextLabel")
    label.Size = UDim2.fromScale(1, 1)
    label.BackgroundTransparency = 0.3
    label.TextScaled = true
    label.Text = "[" .. prompt.KeyboardKeyCode.Name .. "] "
        .. prompt.ActionText
        .. "\n"
        .. prompt.ObjectText
    label.Parent = gui

    markers[prompt] = gui
end

for _, obj in ipairs(game:GetDescendants()) do
    if obj:IsA("ProximityPrompt") then
        addPrompt(obj)
    end
end

game.DescendantAdded:Connect(function(obj)
    if obj:IsA("ProximityPrompt") then
        task.wait()
        addPrompt(obj)
    end
end)

game.DescendantRemoving:Connect(function(obj)
    if markers[obj] then
        markers[obj]:Destroy()
        markers[obj] = nil
    end
end)
